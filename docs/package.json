{
  "name": "pulse-docs",
  "version": "0.20.24",
  "private": true,
  "type": "module",
  "description": "Pulse framework documentation site",
  "scripts": {
    "dev": "node server.js",
    "start": "node server.js",
    "build": "node ../packages/pulse/scripts/build.js --root .",
    "postinstall": "cd ../packages/pulse && npm install --no-package-lock --no-audit --no-fund --loglevel=error && cd ../../docs && npm run build"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@invisibleloop/pulse": "file:../packages/pulse",
    "glob": "^11.0.0"
  }
}
