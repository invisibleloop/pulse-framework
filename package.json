{
  "name": "pulse-monorepo",
  "private": true,
  "type": "module",
  "description": "Pulse framework monorepo — see packages/pulse for the published @invisibleloop/pulse package.",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace packages/pulse",
    "build:framework": "npm run build --workspace packages/pulse",
    "test": "npm run test --workspace packages/pulse",
    "typecheck": "npm run typecheck --workspace packages/pulse",
    "docs": "npm run docs --workspace packages/pulse",
    "docs:build": "npm run docs:build --workspace packages/pulse",
    "docs:start": "npm run docs:start --workspace packages/pulse"
  },
  "engines": {
    "node": ">=22"
  }
}
