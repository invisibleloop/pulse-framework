{
  "name": "@invisibleloop/pulse",
  "version": "0.26.11",
  "type": "module",
  "description": "AI-first frontend framework. The spec is the source of truth.",
  "license": "MIT",
  "homepage": "https://pulseframework.dev",
  "bugs": {
    "url": "https://github.com/invisibleloop/pulse-framework/issues"
  },
  "keywords": [
    "framework",
    "frontend",
    "ssr",
    "streaming",
    "spec",
    "mcp",
    "ai",
    "agent"
  ],
  "bin": {
    "pulse": "./src/cli/index.js"
  },
  "types": "./types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./src/server/index.js"
    },
    "./server": {
      "types": "./types/server.d.ts",
      "default": "./src/server/index.js"
    },
    "./runtime": {
      "types": "./types/runtime.d.ts",
      "default": "./src/runtime/index.js"
    },
    "./ssr": {
      "types": "./types/ssr.d.ts",
      "default": "./src/runtime/ssr.js"
    },
    "./navigate": {
      "types": "./types/navigate.d.ts",
      "default": "./src/runtime/navigate.js"
    },
    "./schema": {
      "types": "./types/schema.d.ts",
      "default": "./src/spec/schema.js"
    },
    "./image": {
      "types": "./types/image.d.ts",
      "default": "./src/runtime/image.js"
    },
    "./html": {
      "types": "./types/html.d.ts",
      "default": "./src/html.js"
    },
    "./ui": {
      "types": "./types/ui.d.ts",
      "default": "./src/ui/index.js"
    },
    "./charts": {
      "types": "./types/charts.d.ts",
      "default": "./src/ui/charts.js"
    },
    "./testing": {
      "types": "./types/testing.d.ts",
      "default": "./src/testing/index.js"
    },
    "./md": {
      "types": "./types/md.d.ts",
      "default": "./src/md/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "node --watch src/cli/dev.js",
    "build": "node scripts/build.js",
    "test": "node src/spec/schema.test.js && node src/runtime/runtime.test.js && node src/runtime/navigate.test.js && node src/runtime/morph.test.js && node src/runtime/ssr.test.js && node src/runtime/image.test.js && node src/server/server.test.js && node src/cli/cli.test.js && node src/cli/validate.test.js && node src/cli/diagnose.test.js && node src/cli/check-bundles.test.js && node src/cli/review.test.js && node src/cli/process-utils.test.js && node src/cli/stamp.test.js && node src/cli/feedback.test.js && node src/cli/update.test.js && node src/cli/dev-host.test.js && node src/cli/dev-reload.test.js && node src/ui/ui.test.js && node src/testing/testing.test.js && node src/store/store.test.js && node src/md/md.test.js && node scripts/strip-server.test.js && node scripts/gen-ui-types.test.js && node scripts/css-purge.test.js && node scripts/bootstrap.test.js && node scripts/release-version.test.js && node src/mcp/mcp.test.js && node src/mcp/approval.test.js && node src/mcp/guards.test.js",
    "typecheck": "tsc --noEmit",
    "docs": "node --watch src/cli/dev.js --root ../../docs --port 4000",
    "docs:start": "node ../../docs/server.js",
    "gen:types": "node scripts/gen-ui-types.js"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "acorn": "^8.19.0",
    "esbuild": "^0.28.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/invisibleloop/pulse-framework",
    "directory": "packages/pulse"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2",
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^3.25 || ^4.0"
  },
  "peerDependenciesMeta": {
    "@modelcontextprotocol/sdk": {
      "optional": true
    },
    "zod": {
      "optional": true
    }
  },
  "typesVersions": {
    "*": {
      "server": [
        "types/server.d.ts"
      ],
      "runtime": [
        "types/runtime.d.ts"
      ],
      "ssr": [
        "types/ssr.d.ts"
      ],
      "navigate": [
        "types/navigate.d.ts"
      ],
      "schema": [
        "types/schema.d.ts"
      ],
      "image": [
        "types/image.d.ts"
      ],
      "html": [
        "types/html.d.ts"
      ],
      "ui": [
        "types/ui.d.ts"
      ],
      "charts": [
        "types/charts.d.ts"
      ],
      "testing": [
        "types/testing.d.ts"
      ],
      "md": [
        "types/md.d.ts"
      ]
    }
  }
}
